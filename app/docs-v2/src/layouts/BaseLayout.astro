---
import "@jongh/ui/style.css"
import "@jongh/ui/theme/blue.css"
import "@/styles/global.css"

interface Props {
  title?: string
}

const { title = "이종혁" } = Astro.props
---

<!doctype html>
<html lang="ko" data-color-theme="blue">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="stylesheet" href="/fonts/pretendard/v1.3.9/pretendardvariable-dynamic-subset.css" />
    {import.meta.env.DEV && <link rel="stylesheet" href="/virtual:stylex.css" />}
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
