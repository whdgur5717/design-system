---
import { render } from "astro:content"

import MdxImage from "@/components/MdxImage.astro"
import MdxThumbnail from "@/components/MdxThumbnail.astro"
import { mdxComponents } from "@/components/mdx"
import BaseLayout from "@/layouts/BaseLayout.astro"
import { source } from "@/lib/source"

export function getStaticPaths() {
  return source.getPages().map((page) => ({
    params: { id: page.slugs[0] },
    props: { page },
  }))
}

type PostPage = (typeof source)["$inferPage"]

const { page } = Astro.props as { page: PostPage }
const { Content } = await render(page.data.entry)
const publishedAt = new Intl.DateTimeFormat("ko-KR", {
  dateStyle: "long",
  timeZone: "Asia/Seoul",
}).format(new Date(page.data.publishedAt))
---

<BaseLayout title={`${page.data.title} — 이종혁`}>
  <main class="page post-page">
    <nav class="section post-nav" aria-label="글 탐색">
      <div class="nav-row">
        <a class="back" href="/">← 글 목록</a>
        <time class="post-date" datetime={page.data.publishedAt}>{publishedAt}</time>
      </div>
      <div class="progress-track" aria-hidden="true">
        <div class="progress-fill"></div>
      </div>
    </nav>

    <header class="section hero">
      <p class="eyebrow">
        {page.data.tags.join(" · ")}
      </p>
      <h1 class="post-title">{page.data.title}</h1>
    </header>

    <div class="section content">
      <article class="article">
        <Content components={{ ...mdxComponents, img: MdxImage, Thumbnail: MdxThumbnail }} />
      </article>

      <aside class="rail" aria-label="목차">
        {
          page.data.structuredData.headings.map((heading, index) => (
            <a class="rail-item" href={`#${heading.id}`} aria-current={index === 0 ? "location" : undefined}>
              <span class="rail-marker" aria-hidden="true" />
              <span>{heading.content.replace(/\\([^\p{L}\p{N}\s])/gu, "$1").replaceAll("`", "")}</span>
            </a>
          ))
        }
      </aside>
    </div>
  </main>
</BaseLayout>

<script>
  const progressFill = document.querySelector<HTMLElement>(".progress-fill")
  const railItems = [...document.querySelectorAll<HTMLAnchorElement>(".rail-item")]
  const headings = railItems.map((item) =>
    document.getElementById(item.getAttribute("href")!.slice(1)),
  )

  function updateReadingPosition() {
    const scrollableHeight = document.documentElement.scrollHeight - window.innerHeight
    const progress = scrollableHeight > 0 ? window.scrollY / scrollableHeight : 1
    if (progressFill) {
      progressFill.style.transform = `scaleX(${Math.min(1, Math.max(0, progress))})`
    }

    let activeIndex = 0
    headings.forEach((heading, index) => {
      if (heading && heading.getBoundingClientRect().top <= window.innerHeight / 4) {
        activeIndex = index
      }
    })
    railItems.forEach((item, index) => {
      if (index === activeIndex) item.setAttribute("aria-current", "location")
      else item.removeAttribute("aria-current")
    })
  }

  let frame = 0
  function scheduleUpdate() {
    if (frame) return
    frame = requestAnimationFrame(() => {
      frame = 0
      updateReadingPosition()
    })
  }

  window.addEventListener("scroll", scheduleUpdate, { passive: true })
  window.addEventListener("resize", scheduleUpdate)
  scheduleUpdate()
</script>
